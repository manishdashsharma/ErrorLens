# ============================================
# ERRORLENS - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and customize for your project
# SECURITY WARNING: Never commit .env to version control!

# ============================================
# CORE CONFIGURATION (Required)
# ============================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL (REQUIRED)
# Format: postgresql://username:password@host:port/database
# Matches the `postgres` service in docker-compose.yml
DATABASE_URL=postgresql://errorlens:errorlens@localhost:5432/errorlens

# PostgreSQL Read Replica (OPTIONAL - for scaling read operations)
# If not set, all reads will use DATABASE_URL
DATABASE_READ_URL=postgresql://errorlens:errorlens@localhost:5432/errorlens

# ============================================
# REDIS CONFIGURATION (Optional but Recommended)
# ============================================
# Used for: caching, sessions, rate limiting, job queues
# Supports single instance or cluster (comma-separated URLs)
# Leave empty to disable Redis
# Matches the `redis` service in docker-compose.yml
REDIS_CLUSTER_URLS=redis://localhost:6379
# REQUIRED for docker-compose's redis service (started with --requirepass)
REDIS_PASSWORD=your_redis_password

# ============================================
# INNGEST (Self-hosted background jobs / durable workflows)
# ============================================
# Used for: git correlation, LLM analysis, Slack delivery pipeline
# Self-hosted via the `inngest` service in docker-compose.yml
# Keys must be hex strings with an even number of characters
# Generate with: node -e "console.log(require('crypto').randomBytes(20).toString('hex'))"
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key
# Where the app reaches the self-hosted Inngest server (dashboard/API)
INNGEST_BASE_URL=http://localhost:8288
# Only needed for local dev: the app runs on the host, self-hosted Inngest
# runs in Docker — the container needs this address to call the app back
# ("localhost" from inside the container means the container itself).
# host.docker.internal works on Docker Desktop (macOS/Windows); on Linux
# use --add-host=host.docker.internal:host-gateway or the host's LAN IP.
INNGEST_SERVE_ORIGIN=http://host.docker.internal:3000

# ============================================
# ADMIN AUTHENTICATION (Required)
# ============================================
# Shared secret for the control plane (project/API-key management).
# No user accounts, no login flow — self-hosted, single-tenant instance,
# sent as the `x-admin-secret` header on every /projects request.
# SECURITY: Use a strong, unique secret in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your-admin-secret-key-minimum-32-characters-recommended

# ============================================
# GIT CORRELATION (Optional — enrichment stays skipped without it)
# ============================================
# Personal access token with repo read scope, used to correlate a captured
# error with the git commit that most likely introduced it.
# GITHUB_TOKEN=your_github_token

# ============================================
# LLM ANALYSIS (Optional — enrichment stays skipped without it)
# ============================================
# Pluggable provider for root-cause explanation. Leave unset to skip.
# LLM_PROVIDER=openai
# LLM_API_KEY=your_llm_api_key

# ============================================
# RATE LIMITING
# ============================================
# Protect against DDoS and brute force attacks
RATE_LIMIT_WINDOW_MS=900000          # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100          # Max requests per window per IP

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# Use * for development only! Specify exact URLs in production
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============================================
# LOGGING
# ============================================
# Options: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ============================================
# NOTES
# ============================================
# - Required variables will cause startup failure if missing
# - Optional variables will be logged as warnings if not set
# - Always use environment-specific .env files
# - Review all defaults in src/config/index.js
# - Test configuration with: npm run dev
