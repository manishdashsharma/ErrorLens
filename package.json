{
  "name": "errorlens",
  "version": "1.0.0",
  "description": "Self-hosted, AI-native error tracking for Node/Express apps — PostgreSQL, Redis, and optional third-party integrations",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/extension-accelerate": "^3.0.1",
    "bull": "^4.16.5",
    "colorette": "^2.0.20",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "glob": "^13.0.6",
    "helmet": "^8.3.0",
    "inngest": "^4.18.1",
    "ioredis": "^6.0.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "octokit": "^5.0.5",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "source-map-support": "^0.5.21",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1"
  },
  "keywords": [
    "express",
    "error-tracking",
    "self-hosted",
    "nodejs",
    "postgresql",
    "prisma",
    "redis",
    "ai",
    "sentry-alternative"
  ],
  "author": "Manish Dash Sharma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manishdashsharma/errorlens.git"
  },
  "bugs": {
    "url": "https://github.com/manishdashsharma/errorlens/issues"
  },
  "homepage": "https://github.com/manishdashsharma/errorlens#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
