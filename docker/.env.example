# ============================================
# ERRORLENS - STANDALONE DEPLOYMENT CONFIG
# ============================================
# Copy this file to .env next to docker-compose.yml and fill in the
# secrets below. DATABASE_URL, REDIS_CLUSTER_URLS, INNGEST_BASE_URL and
# INNGEST_SERVE_ORIGIN are already set in docker-compose.yml — this file
# only needs the values that are actually secrets or genuinely optional.
# SECURITY WARNING: Never commit .env to version control!

NODE_ENV=production
PORT=3000
API_VERSION=v1

# Postgres/Redis service passwords used inside the compose network.
# REQUIRED for the redis service (started with --requirepass).
REDIS_PASSWORD=your_redis_password

# Self-hosted Inngest event/signing keys — hex strings, even length.
# Generate with: node -e "console.log(require('crypto').randomBytes(20).toString('hex'))"
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Shared secret for the control plane (project/API-key management),
# sent as the `x-admin-secret` header on every /projects request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your-admin-secret-key-minimum-32-characters-recommended

# ============================================
# OPTIONAL ENRICHMENT — leave unset to skip
# ============================================

# Personal access token with repo read scope, used to correlate a
# captured error with the git commit that most likely introduced it.
# GITHUB_TOKEN=your_github_token

# OpenAI-compatible provider for root-cause explanation. Defaults target
# Groq; point AI_BASE_URL/AI_MODEL at any other OpenAI-compatible
# provider to switch without touching code. Leave AI_API_KEY unset to skip.
# AI_API_KEY=your_ai_provider_api_key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# ============================================
# RATE LIMITING / RETENTION / CORS / LOGGING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
INGESTION_RATE_LIMIT_MAX_REQUESTS=2000
RETENTION_DAYS=90
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
